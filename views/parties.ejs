<%- include('partials/header', { titre: 'Parties prenantes' }) %>
<h1>Module 7 — Engagement des parties prenantes</h1>
<p class="sous-titre">Cartographie par site et journal des interactions avec engagements suivis (EF-PAR-01/03/04)</p>

<h2>Cartographie</h2>
<details class="form-ajout"><summary>+ Nouvelle partie prenante</summary><div>
  <form method="post" action="/parties-prenantes">
    <div class="champs-3">
      <div class="champ"><label>Nom *</label><input name="nom" required></div>
      <div class="champ"><label>Catégorie *</label>
        <select name="categorie"><option>communauté</option><option>autorité</option><option>ONG</option><option>syndicat</option><option>média</option><option>association de consommateurs</option><option>groupe vulnérable</option></select></div>
      <div class="champ"><label>Site</label><select name="site_id"><option value="">Groupe</option><% sites.forEach(s => { %><option value="<%= s.id %>"><%= s.nom %></option><% }) %></select></div>
      <div class="champ"><label>Contact</label><input name="contact"></div>
    </div>
    <button type="submit">Enregistrer</button>
  </form>
</div></details>
<div class="table-scroll"><table>
  <tr><th>Nom</th><th>Catégorie</th><th>Site</th><th>Contact</th></tr>
  <% pps.forEach(p => { %>
    <tr><td><b><%= p.nom %></b></td><td><span class="badge gris"><%= p.categorie %></span></td><td><%= p.site_nom || 'Groupe' %></td><td><%= p.contact || '—' %></td></tr>
  <% }) %>
</table></div>

<h2>Journal des interactions</h2>
<details class="form-ajout"><summary>+ Nouvelle interaction</summary><div>
  <form method="post" action="/interactions">
    <div class="champs-3">
      <div class="champ"><label>Partie prenante</label>
        <select name="partie_prenante_id"><option value="">—</option><% pps.forEach(p => { %><option value="<%= p.id %>"><%= p.nom %></option><% }) %></select></div>
      <div class="champ"><label>Site</label><select name="site_id"><option value="">—</option><% sites.forEach(s => { %><option value="<%= s.id %>"><%= s.nom %></option><% }) %></select></div>
      <div class="champ"><label>Type *</label><select name="type"><option>consultation</option><option>courrier</option><option>visite</option><option>campagne d'information</option></select></div>
      <div class="champ"><label>Date *</label><input type="date" name="date_interaction" required></div>
    </div>
    <div class="champ"><label>Résumé (pièces jointes et listes de présence archivées en GED)</label><textarea name="resume"></textarea></div>
    <div class="champ"><label>Engagements pris</label><textarea name="engagements"></textarea></div>
    <button type="submit">Enregistrer</button>
  </form>
</div></details>
<div class="table-scroll"><table>
  <tr><th>Date</th><th>Partie prenante</th><th>Site</th><th>Type</th><th>Résumé</th><th>Engagements</th></tr>
  <% interactions.forEach(i => { %>
    <tr><td><%= i.date_interaction %></td><td><%= i.pp_nom || '—' %></td><td><%= i.site_nom || '—' %></td>
      <td><span class="badge gris"><%= i.type %></span></td><td><%= i.resume || '—' %></td><td><%= i.engagements || '—' %></td></tr>
  <% }) %>
</table></div>
<%- include('partials/footer') %>
