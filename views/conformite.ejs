<%- include('partials/header', { titre: 'Conformité' }) %>
<h1>Module 3 : Conformité légale, permis et autorisations</h1>
<p class="sous-titre">Registre réglementaire, alertes d'échéance J-180 à J-7, covenants IFC (EF-CONF-01/02/03/07)</p>

<% if (taux !== null) { %>
<div class="grille-kpi">
  <div class="kpi <%= taux>=80 ? '' : taux>=50 ? 'orange' : 'rouge' %>"><div class="valeur"><%= taux %> %</div><div class="libelle">Taux de conformité des exigences évaluées</div></div>
  <div class="kpi <%= permis.filter(p=>p.alerte).length ? 'orange' : '' %>"><div class="valeur"><%= permis.filter(p=>p.alerte).length %></div><div class="libelle">Permis en alerte</div></div>
  <div class="kpi"><div class="valeur"><%= permis.length %></div><div class="libelle">Permis suivis</div></div>
</div>
<% } %>

<h2>Permis, agréments et autorisations</h2>
<details class="form-ajout"><summary>+ Nouveau permis / autorisation</summary><div>
  <form method="post" action="/permis" enctype="multipart/form-data">
    <div class="champs-3">
      <div class="champ"><label>Site *</label><select name="site_id" required><% sites.forEach(s => { %><option value="<%= s.id %>"><%= s.nom %></option><% }) %></select></div>
      <div class="champ"><label>Type *</label><input name="type" required placeholder="Récépissé ICPE, agrément…"></div>
      <div class="champ"><label>Référence</label><input name="reference"></div>
      <div class="champ"><label>Autorité émettrice</label><input name="autorite"></div>
      <div class="champ"><label>Date d'obtention</label><input type="date" name="date_obtention"></div>
      <div class="champ"><label>Date d'expiration</label><input type="date" name="date_expiration"></div>
    </div>
    <div class="champ"><label>Commentaire</label><input name="commentaire"></div>
    <div class="champ"><label>Document du permis (scan PDF ou photo)</label>
      <input type="file" name="fichiers" multiple accept=".jpg,.jpeg,.png,.webp,.pdf"></div>
    <button type="submit">Enregistrer</button>
  </form>
</div></details>

<div class="table-scroll"><table>
  <tr><th>Site</th><th>Type</th><th>Référence</th><th>Autorité</th><th>Expiration</th><th>Alerte</th><th>Statut</th></tr>
  <% permis.forEach(p => { %>
    <tr>
      <td><%= p.site_nom %> <small style="color:var(--gris)">(<%= p.pays %>)</small></td>
      <td><b><%= p.type %></b><% if (p.commentaire) { %><br><small style="color:var(--gris)"><%= p.commentaire %></small><% } %>
        <% p.pieces.forEach(pj => { %><br>📎 <a href="/fichiers/<%= pj.id %>" style="font-size:.8rem;"><%= pj.nom_original %></a><% }) %>
        <details class="no-print" style="font-size:.78rem;"><summary style="cursor:pointer;color:var(--gris);">joindre le document</summary>
          <form method="post" action="/permis/<%= p.id %>/pieces" enctype="multipart/form-data" style="display:flex;gap:.4rem;align-items:center;margin-top:.3rem;">
            <input type="file" name="fichiers" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" required>
            <button class="bouton mini" type="submit">OK</button>
          </form>
        </details></td>
      <td><%= p.reference || 'N/A' %></td><td><%= p.autorite || 'N/A' %></td>
      <td><%= fdate(p.date_expiration) %><% if (p.jours !== null) { %> <small>(<%= p.jours<0 ? -p.jours + ' j de retard' : 'J-' + p.jours %>)</small><% } %></td>
      <td><% if (p.alerte) { %><span class="badge <%= p.alerte.classe %>"><%= p.alerte.seuil %></span><% } else { %><span class="badge vert">OK</span><% } %></td>
      <td><span class="badge <%= p.statut==='valide' ? 'vert' : p.statut==='expire' ? 'rouge' : 'orange' %>"><%= L(p.statut) %></span></td>
    </tr>
  <% }) %>
</table></div>

<h2>Registre des exigences légales et covenants IFC</h2>
<details class="form-ajout"><summary>+ Nouvelle exigence</summary><div>
  <form method="post" action="/exigences">
    <div class="champs-3">
      <div class="champ"><label>Pays *</label><input name="pays" required></div>
      <div class="champ"><label>Thématique *</label><input name="thematique" required></div>
      <div class="champ"><label>Statut</label>
        <select name="statut_conformite"><option value="a_evaluer">à évaluer</option><option value="conforme">conforme</option><option value="partiel">partiel</option><option value="non_conforme">non conforme</option></select></div>
    </div>
    <div class="champ"><label>Texte / exigence *</label><textarea name="texte" required></textarea></div>
    <div class="champ"><label>Applicabilité</label><input name="applicabilite"></div>
    <div class="champ"><label><input type="checkbox" name="covenant_ifc" value="1" style="width:auto"> Covenant E&amp;S du contrat de prêt IFC (EF-CONF-07)</label></div>
    <button type="submit">Enregistrer</button>
  </form>
</div></details>

<div class="table-scroll"><table>
  <tr><th>Pays</th><th>Thématique</th><th>Texte</th><th>Applicabilité</th><th>Conformité</th></tr>
  <% exigences.forEach(e => { %>
    <tr>
      <td><%= e.pays %></td>
      <td><%= e.thematique %><% if (e.covenant_ifc) { %> <span class="badge violet">Covenant IFC</span><% } %></td>
      <td><%= e.texte %></td><td style="font-size:.8rem;"><%= e.applicabilite || 'N/A' %></td>
      <td>
        <form class="inline" method="post" action="/exigences/<%= e.id %>/statut">
          <select name="statut_conformite" class="mini">
            <% [['conforme','conforme'],['partiel','partiel'],['non_conforme','non conforme'],['a_evaluer','à évaluer']].forEach(([v,l]) => { %>
              <option value="<%= v %>" <%= e.statut_conformite===v ? 'selected' : '' %>><%= l %></option>
            <% }) %>
          </select>
          <button class="bouton mini" type="submit">OK</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table></div>
<%- include('partials/footer') %>
