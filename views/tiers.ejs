<%- include('partials/header', { titre: 'Tiers' }) %>
<h1>Module 17 — Fournisseurs, sous-traitants et tiers</h1>
<p class="sous-titre">Référentiel avec cotation du risque E&amp;S, code de conduite et clauses contractuelles (EF-TIE-01/03)</p>

<details class="form-ajout"><summary>+ Nouveau tiers</summary><div>
  <form method="post" action="/tiers">
    <div class="champs-3">
      <div class="champ"><label>Nom *</label><input name="nom" required></div>
      <div class="champ"><label>Type *</label>
        <select name="type"><option>fournisseur</option><option>sous-traitant</option><option>transporteur</option><option>gardiennage</option><option>franchisé</option></select></div>
      <div class="champ"><label>Entité de rattachement</label>
        <select name="entite_id"><option value="">Groupe</option><% entites.forEach(e => { %><option value="<%= e.id %>"><%= e.nom %></option><% }) %></select></div>
      <div class="champ"><label>Score E&amp;S (0–100)</label><input type="number" name="score_es" min="0" max="100"></div>
      <div class="champ"><label>Dernier audit</label><input type="date" name="dernier_audit"></div>
    </div>
    <div class="champ">
      <label><input type="checkbox" name="critique" value="1" style="width:auto"> Tiers critique</label>
      <label><input type="checkbox" name="code_conduite_accepte" value="1" style="width:auto"> Code de conduite fournisseurs accepté</label>
      <label><input type="checkbox" name="clauses_es_contrat" value="1" style="width:auto"> Clauses E&amp;S insérées au contrat</label>
    </div>
    <button type="submit">Enregistrer</button>
  </form>
</div></details>

<div class="table-scroll"><table>
  <tr><th>Nom</th><th>Type</th><th>Entité</th><th>Criticité</th><th>Score E&amp;S</th><th>Code de conduite</th><th>Clauses E&amp;S</th><th>Dernier audit</th></tr>
  <% rows.forEach(t => { %>
    <tr>
      <td><b><%= t.nom %></b></td><td><%= t.type %></td><td><%= t.entite_nom || 'Groupe' %></td>
      <td><%= t.critique ? '' : '' %><span class="badge <%= t.critique ? 'rouge' : 'gris' %>"><%= t.critique ? 'critique' : 'standard' %></span></td>
      <td><% if (t.score_es !== null) { %><span class="badge <%= t.score_es>=70 ? 'vert' : t.score_es>=50 ? 'orange' : 'rouge' %>"><%= t.score_es %>/100</span><% } else { %><span class="badge gris">non évalué</span><% } %></td>
      <td><%= t.code_conduite_accepte ? '✔' : '✘' %></td>
      <td><%= t.clauses_es_contrat ? '✔' : '✘' %></td>
      <td><%= t.dernier_audit || '—' %></td>
    </tr>
  <% }) %>
</table></div>
<%- include('partials/footer') %>
