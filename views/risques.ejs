<%- include('partials/header', { titre: 'Risques' }) %>
<h1>Module 2 — Registre des risques et impacts E&amp;S</h1>
<p class="sous-titre">Cotation gravité × probabilité, risque brut et net, par entité, site et Norme de Performance (EF-RIS-01/03)</p>

<div class="carte" style="display:flex;gap:2rem;flex-wrap:wrap;align-items:center;">
  <div>
    <h3 style="margin-top:0;">Matrice de cotation</h3>
    <table class="matrice">
      <tr><th></th><th colspan="5">Probabilité →</th></tr>
      <% for (let g = 5; g >= 1; g--) { %>
        <tr><th><%= g===5 ? 'G 5' : g %></th>
        <% for (let p = 1; p <= 5; p++) { const s = g*p; %>
          <td class="<%= s>=15 ? 'm-r' : s>=8 ? 'm-o' : s>=4 ? 'm-j' : 'm-v' %>"><%= s %></td>
        <% } %></tr>
      <% } %>
    </table>
  </div>
  <div style="font-size:.85rem;color:var(--gris);max-width:380px;">
    Score = gravité × probabilité. <span class="badge rouge">≥ 15 critique</span> <span class="badge orange">8–14 élevé</span>
    <span class="badge jaune">4–7 modéré</span> <span class="badge vert">&lt; 4 faible</span><br><br>
    Toute révision de cotation exige une justification, historisée dans la piste d'audit (EF-RIS-08).
  </div>
</div>

<details class="form-ajout"><summary>+ Nouveau risque</summary><div>
  <form method="post" action="/risques">
    <div class="champ"><label>Description *</label><textarea name="description" required></textarea></div>
    <div class="champs-3">
      <div class="champ"><label>Entité</label><select name="entite_id"><option value="">—</option><% entites.forEach(e => { %><option value="<%= e.id %>"><%= e.nom %></option><% }) %></select></div>
      <div class="champ"><label>Site</label><select name="site_id"><option value="">—</option><% sites.forEach(s => { %><option value="<%= s.id %>"><%= s.nom %></option><% }) %></select></div>
      <div class="champ"><label>Norme de Performance</label>
        <select name="ps"><% ['PS1','PS2','PS3','PS4','PS5','PS6','PS7','PS8'].forEach(ps => { %><option><%= ps %></option><% }) %></select></div>
      <div class="champ"><label>Catégorie</label><input name="categorie"></div>
      <div class="champ"><label>Gravité brute (1–5) *</label><input type="number" name="gravite_brute" min="1" max="5" required></div>
      <div class="champ"><label>Probabilité brute (1–5) *</label><input type="number" name="probabilite_brute" min="1" max="5" required></div>
      <div class="champ"><label>Gravité nette</label><input type="number" name="gravite_nette" min="1" max="5"></div>
      <div class="champ"><label>Probabilité nette</label><input type="number" name="probabilite_nette" min="1" max="5"></div>
      <div class="champ"><label>Responsable</label><input name="responsable"></div>
    </div>
    <div class="champ"><label>Mesures de maîtrise</label><textarea name="mesures"></textarea></div>
    <button type="submit">Enregistrer</button>
  </form>
</div></details>

<div class="table-scroll"><table>
  <tr><th>PS</th><th>Description</th><th>Périmètre</th><th>Brut</th><th>Net</th><th>Mesures de maîtrise</th><th>Statut</th><th>Réviser</th></tr>
  <% rows.forEach(r => { const brut = r.gravite_brute*r.probabilite_brute; const net = r.gravite_nette ? r.gravite_nette*r.probabilite_nette : null; %>
    <tr>
      <td><span class="badge violet"><%= r.ps %></span></td>
      <td><b><%= r.description %></b><% if (r.justification_revision) { %><br><small style="color:var(--gris)">Dernière révision : <%= r.justification_revision %></small><% } %></td>
      <td><%= r.site_nom || r.entite_nom || 'Groupe' %></td>
      <td><span class="badge <%= brut>=15 ? 'rouge' : brut>=8 ? 'orange' : brut>=4 ? 'jaune' : 'vert' %>"><%= brut %></span></td>
      <td><% if (net) { %><span class="badge <%= net>=15 ? 'rouge' : net>=8 ? 'orange' : net>=4 ? 'jaune' : 'vert' %>"><%= net %></span><% } else { %>—<% } %></td>
      <td style="font-size:.8rem;"><%= r.mesures || '—' %></td>
      <td><span class="badge <%= r.statut==='maitrise' ? 'vert' : r.statut==='clos' ? 'gris' : 'orange' %>"><%= r.statut %></span></td>
      <td>
        <details><summary style="cursor:pointer;font-size:.8rem;">réviser</summary>
          <form method="post" action="/risques/<%= r.id %>/revision" style="min-width:180px;">
            <input class="mini" type="number" name="gravite_nette" min="1" max="5" placeholder="G nette" value="<%= r.gravite_nette || '' %>" required>
            <input class="mini" type="number" name="probabilite_nette" min="1" max="5" placeholder="P nette" value="<%= r.probabilite_nette || '' %>" required>
            <select name="statut" class="mini"><option value="ouvert" <%= r.statut==='ouvert'?'selected':'' %>>ouvert</option><option value="maitrise" <%= r.statut==='maitrise'?'selected':'' %>>maîtrisé</option><option value="clos" <%= r.statut==='clos'?'selected':'' %>>clos</option></select>
            <input name="justification" placeholder="Justification obligatoire" required style="margin-top:.3rem;">
            <button class="bouton mini" type="submit" style="margin-top:.3rem;">Valider</button>
          </form>
        </details>
      </td>
    </tr>
  <% }) %>
</table></div>
<%- include('partials/footer') %>
